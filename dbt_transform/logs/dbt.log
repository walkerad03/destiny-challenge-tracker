  create  table "airflow"."silver"."slv_activity_history"
  
  
    as
  
  (
    

WITH source_data AS (
    SELECT
        account_id,
        character_id,
        page_number,
        jsonb_array_elements(payload -> 'Response' -> 'activities') AS activity,
        ingested_at
    FROM "airflow"."bronze"."raw_activity_history"

    
)

SELECT
    account_id,
